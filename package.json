{
  "name": "saucedemo-playwright-automation",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:all": "playwright test",
    "test:smoke": "npm run auth:setup && playwright test --grep @smoke --project=chromium",
    "auth:setup": "playwright test tests/auth/setup.auth.ts --project=setup",
    "test:regression": "playwright test --grep @regression",
    "test:negative": "playwright test --grep @negative",
    "test:auth": "playwright test --grep @auth",
    "test:product": "playwright test --grep @product",
    "test:cart": "playwright test --grep @cart",
    "test:checkout": "playwright test --grep @checkout",
    "test:performance": "playwright test --grep @performance",
    "test:chrome": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
